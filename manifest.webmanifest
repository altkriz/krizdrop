{
  "id": "/krizdrop/",
  "name": "KrizDrop — Direct P2P File & Text Transfer",
  "short_name": "KrizDrop",
  "description": "Instant, encrypted peer-to-peer file and text sharing directly between browsers.",
  "start_url": "/krizdrop/",
  "scope": "/krizdrop/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#070b14",
  "theme_color": "#0b1220",
  "icons": [
    {
      "src": "/krizdrop/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/krizdrop/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "https://altkriz.github.io/favicon.ico",
      "sizes": "48x48 64x64 128x128 256x256",
      "type": "image/x-icon"
    }
  ],
  "share_target": {
    "action": "/krizdrop/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shared_files",
          "accept": ["image/*", "video/*", "audio/*", "application/*", "text/*", "*/*"]
        }
      ]
    }
  }
}
